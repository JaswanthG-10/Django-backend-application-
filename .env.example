# Django Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# API Caller Security (Provide via X-API-KEY header or Authorization: Api-Key <key>)
API_KEY_SECRET=replace-with-a-secure-random-api-key-in-production

# Field-Level Symmetric Encryption Key for sensitive tokens at rest (Fernet 32-byte urlsafe base64 key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-encryption-key-in-production

# Asynchronous Background Execution (Bounded Thread Pool / Standalone Worker)
EXTRACTION_ASYNC_EXECUTION=True
EXTRACTION_MAX_WORKERS=4
EXTRACTION_JOB_TIMEOUT_MINUTES=15

# Database Configuration (PostgreSQL in production/CI, SQLite fallback for local quick-start)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greentree_db

# External Extraction API Configuration
# Defaults to JSONPlaceholder as a live accessible data source, or any CRM URL (e.g. HubSpot)
EXTERNAL_API_BASE_URL=https://jsonplaceholder.typicode.com
EXTERNAL_API_TIMEOUT=10
EXTERNAL_API_DEFAULT_TOKEN=test-sample-service-token
EXTERNAL_API_PAGINATION_TYPE=auto
EXTERNAL_API_ENDPOINT_TEMPLATE=/posts
EXTERNAL_API_RECORDS_KEY=

# Job Recovery & Retries
EXTRACTION_MAX_RETRIES=3

# HMAC-SHA256 Request Signing Security (Optional: enforce cryptographic request signing)
API_REQUIRE_REQUEST_SIGNING=False
API_SIGNING_TOLERANCE_SECONDS=300

# Logging
LOG_LEVEL=INFO

