# Django Settings (Local Development Defaults)
# For local development: DEBUG=True and SQLite are permitted.
# For production: See .env.production.example (DEBUG=False, PostgreSQL, and real production secrets required).
DEBUG=True
SECRET_KEY=local-dev-fake-secret-key-change-me-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# API Caller Security (Provide via X-API-KEY header or Authorization: Api-Key <key>)
# Clearly fake local development key
API_KEY_SECRET=local-dev-fake-api-key-secret-12345

# Field-Level Symmetric Encryption Key for sensitive tokens at rest (Fernet 32-byte urlsafe base64 key)
# Generate a real production key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=ZmFrZS1mZXJuZXQta2V5LTMyLWJ5dGVzLWxvbmchISE=

# Asynchronous Background Execution (Bounded Thread Pool / Standalone Worker)
EXTRACTION_ASYNC_EXECUTION=True
EXTRACTION_MAX_WORKERS=4
EXTRACTION_JOB_TIMEOUT_MINUTES=15
EXTRACTION_MAX_RETRIES=3

# Heartbeat & Stale Job Recovery Configuration
EXTRACTION_HEARTBEAT_INTERVAL_SECONDS=30
EXTRACTION_STALE_THRESHOLD_MINUTES=15

# Database Configuration (PostgreSQL in production/CI, SQLite fallback for local quick-start)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greentree_db

# External Extraction API Configuration
# Documented production default: HubSpot CRM Objects API (https://developers.hubspot.com/docs/api/crm/contacts)
# Or configure to any CRM / REST provider endpoint.
EXTERNAL_API_BASE_URL=https://api.hubapi.com
EXTERNAL_API_TIMEOUT=10
EXTERNAL_API_DEFAULT_TOKEN=
EXTERNAL_API_PAGINATION_TYPE=auto
EXTERNAL_API_ENDPOINT_TEMPLATE={base_url}/crm/v3/objects/{source_type}
EXTERNAL_API_RECORDS_KEY=results
EXTERNAL_API_CURSOR_PARAM=after
EXTERNAL_API_PAGE_SIZE=100
EXTERNAL_API_MAX_PAGES=2000
EXTERNAL_API_ON_PAGE_LIMIT=fail
EXTERNAL_API_MAX_RATE_LIMIT_RETRIES=5
EXTERNAL_API_MAX_RETRY_AFTER_SECONDS=60
EXTERNAL_API_MAX_TOTAL_RATE_LIMIT_WAIT_SECONDS=300
# SSRF Protection: Allowed destination hosts for pagination and redirects (comma-separated).
# Default empty means only the host in EXTERNAL_API_BASE_URL is permitted.
EXTERNAL_API_ALLOWED_HOSTS=
# Allow loopback (127.0.0.1, localhost) for local mock server development only when DEBUG=True.
EXTERNAL_API_ALLOW_LOOPBACK=False

# HMAC-SHA256 Request Signing Security (Optional: enforce cryptographic request signing)
API_REQUIRE_REQUEST_SIGNING=False
API_SIGNING_TOLERANCE_SECONDS=300

# Logging
LOG_LEVEL=INFO

