# Django Settings (Production Template)
# In production, DEBUG must be False. When DEBUG=False, real production values for SECRET_KEY,
# API_KEY_SECRET, FIELD_ENCRYPTION_KEY, DATABASE_URL, and ALLOWED_HOSTS are strictly required.
DEBUG=False

# Generate via: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-secure-random-secret-key-of-at-least-32-chars-in-prod

# Explicit production hostnames / domains
ALLOWED_HOSTS=api.yourproductiondomain.com,your-service.onrender.com

# CSRF trusted origins for production
CSRF_TRUSTED_ORIGINS=https://api.yourproductiondomain.com,https://your-service.onrender.com

# API Caller Security (Provide via X-API-KEY header or Authorization: Api-Key <key>)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SECRET=replace-with-a-unique-production-api-key-secret

# Field-Level Symmetric Encryption Key for sensitive tokens at rest (Fernet 32-byte urlsafe base64 key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-encryption-key-in-production

# Production HTTPS / Security Settings (can opt out if behind SSL-terminating reverse proxy)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Asynchronous Background Execution (Bounded Thread Pool / Standalone Worker)
EXTRACTION_ASYNC_EXECUTION=True
EXTRACTION_MAX_WORKERS=4
EXTRACTION_JOB_TIMEOUT_MINUTES=15
EXTRACTION_MAX_RETRIES=3

# Heartbeat & Stale Job Recovery Configuration
EXTRACTION_HEARTBEAT_INTERVAL_SECONDS=30
EXTRACTION_STALE_THRESHOLD_MINUTES=15

# Database Configuration (PostgreSQL / Supabase required in production)
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/your_database
# For Supabase Pooler:
# DATABASE_URL=postgresql://postgres.projectref:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# External Extraction API Configuration
EXTERNAL_API_BASE_URL=https://api.hubapi.com
EXTERNAL_API_TIMEOUT=10
EXTERNAL_API_DEFAULT_TOKEN=
EXTERNAL_API_PAGINATION_TYPE=auto
EXTERNAL_API_ENDPOINT_TEMPLATE={base_url}/crm/v3/objects/{source_type}
EXTERNAL_API_RECORDS_KEY=results
EXTERNAL_API_CURSOR_PARAM=after
EXTERNAL_API_PAGE_SIZE=100
EXTERNAL_API_MAX_PAGES=2000
EXTERNAL_API_ON_PAGE_LIMIT=fail
EXTERNAL_API_MAX_RATE_LIMIT_RETRIES=5
EXTERNAL_API_MAX_RETRY_AFTER_SECONDS=60
EXTERNAL_API_MAX_TOTAL_RATE_LIMIT_WAIT_SECONDS=300

# HMAC-SHA256 Request Signing Security (Optional: enforce cryptographic request signing)
API_REQUIRE_REQUEST_SIGNING=False
API_SIGNING_TOLERANCE_SECONDS=300

# Logging
LOG_LEVEL=INFO
